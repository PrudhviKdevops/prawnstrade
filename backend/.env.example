# Copy this file to .env and fill in your own values

# --- PostgreSQL connection ---
# Option 1: give a full connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/prawn_trade

# Option 2 (used only if DATABASE_URL is not set): individual fields
PGHOST=localhost
PGPORT=5432
PGDATABASE=prawn_trade
PGUSER=postgres
PGPASSWORD=postgres

# Set to "true" if your Postgres provider requires SSL (e.g. most cloud DBs)
PGSSL=false

# --- App / Auth ---
PORT=5000
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=12h

# --- Default admin account ---
# Created automatically the first time the server starts, only if the
# users table is empty. Change the password immediately after first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
